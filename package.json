{
  "name": "ccreplay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && tsx scripts/build.ts",
    "dev": "tsx scripts/serve.ts",
    "test:recorder": "tsx --test tests/integration/recorder.test.ts",
    "test": "tsx --test tests/*.test.ts",
    "library:import": "tsx scripts/library.ts import",
    "library:apply": "tsx scripts/library.ts apply",
    "library:check": "tsx scripts/check-library.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src recorder desktop scripts tests",
    "desktop:build": "npm run typecheck && tsx scripts/build-desktop.ts",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:package": "npm run desktop:build && tsx scripts/package-desktop.ts",
    "desktop:install": "playwright install chromium",
    "test:desktop": "npm run desktop:build && tsx --test tests/integration/desktop.test.ts"
  },
  "dependencies": {
    "@rrweb/record": "2.0.0-alpha.18",
    "@rrweb/replay": "2.0.0-alpha.18",
    "css-tree": "^3.1.0",
    "fflate": "0.8.2",
    "lucide": "0.468.0",
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.11",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "main": "desktop-dist/main.cjs",
  "description": "CCfolia room-state replay recorder and player",
  "author": "CCReplay"
}
