{
  "name": "ccreplay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && tsx scripts/build.ts",
    "dev": "tsx scripts/serve.ts",
    "record": "node --import tsx scripts/record.ts",
    "record:install": "playwright install chromium",
    "test:recorder": "tsx --test tests/integration/recorder.test.ts",
    "test": "tsx --test tests/*.test.ts",
    "library:import": "tsx scripts/library.ts import",
    "library:apply": "tsx scripts/library.ts apply",
    "library:check": "tsx scripts/check-library.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src extension scripts tests"
  },
  "dependencies": {
    "@rrweb/record": "2.0.0-alpha.18",
    "@rrweb/replay": "2.0.0-alpha.18",
    "css-tree": "^3.1.0",
    "fflate": "0.8.2",
    "lucide": "0.468.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.4",
    "esbuild": "0.25.11",
    "fake-indexeddb": "^6.2.4",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
