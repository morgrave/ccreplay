e20\ub97c \uc5f4\ub78c, \uc0dd\uc131, \ubcc0\uacbd\ud558\ub294 \uc77c\uc740 \uc5c6\uc2b5\ub2c8\ub2e4.","\u203b\u305d\u306e\u3088\u3046\u306a\u884c\u70ba\u306f\u6cd5\u5f8b\u306b\u3088\u308a\u7f70\u305b\u3089\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u3001\u4e07\u304c\u4e00\u3001\u305d\u306e\u3088\u3046\u306a\u884c\u70ba\u3092\u767a\u898b\u3057\u305f\u5834\u5408\u306b\u306f\u6cd5\u7684\u63aa\u7f6e\u3092\u3068\u308b\u5834\u5408\u304c\u3054\u3056\u3044\u307e\u3059\u3002":"\u203b \uadf8\ub7ec\ud55c \ud589\uc704\ub294 \ubc95\ub960\uc5d0 \uc758\ud574 \ucc98\ubc8c\ub420 \uc218 \uc788\uc73c\uba70, \ub9cc\uc77c \uadf8\ub7ec\ud55c \ud589\uc704\ub97c \ubc1c\uacac\ud55c \uacbd\uc6b0\uc5d0\ub294 \ubc95\uc801 \uc870\uce58\ub97c \ucde8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","\u203b\u55b6\u5229\u30fb\u975e\u55b6\u5229\u306b\u304b\u304b\u308f\u3089\u305a\u3001\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u30c7\u30fc\u30bf\u3001\u30eb\u30fc\u30e0\u30c7\u30fc\u30bf\u307e\u305f\u306f\u305d\u308c\u306b\u63a5\u7d9a\u3059\u308bURL\u306e\u518d\u914d\u5e03\u3001\u8ee2\u9001\u3001\u8ee2\u8f09\u3001\u8907\u88fd\u3001\u6539\u3056\u3093\u7b49\u3092\u56fa\u304f\u7981\u3058\u307e\u3059\u3002":"\u203b \uc601\ub9ac, \ube44\uc601\ub9ac\uc5d0 \uad00\uacc4\uc5c6\uc774 \ub2e4\uc6b4\ub85c\ub4dc \ub370\uc774\ud130, \ub8f8 \ub370\uc774\ud130 \ub610\ub294 \uc774\uc5d0 \uc811\uc18d\ud558\ub294 URL\uc758 \uc7ac\ubc30\ud3ec, \uc804\uc1a1, \uc804\uc7ac, \ubcf5\uc81c, \ubcc0\uc870 \ub4f1\uc744 \uae08\ud569\ub2c8\ub2e4.","\u203b\u672c\u4f5c\u54c1\u306e\u8cfc\u5165\u306b\u3088\u308a\u63d0\u4f9b\u3055\u308c\u308b\u5168\u3066\u306e\u30eb\u30fc\u30e0\u30c7\u30fc\u30bf\u306b\u4fc2\u308b\u8457\u4f5c\u6a29\u305d\u306e\u4ed6\u4e00\u5207\u306e\u6a29\u5229\u306f\u3001\u30b3\u30b3\u30d5\u30a9\u30ea\u30a2\u682a\u5f0f\u4f1a\u793e\u307e\u305f\u306f\u6b63\u5f53\u306a\u6a29\u5229\u3092\u6709\u3059\u308b\u7b2c\u4e09\u8005\u306b\u5e30\u5c5e\u3057\u307e\u3059\u3002":"\u203b \ubcf8 \uc791\ud488\uc744 \uad6c\ub9e4\ud558\uc5ec \uc81c\uacf5\ub418\ub294 \ubaa8\ub4e0 \ub8f8 \ub370\uc774\ud130\uc640 \uad00\ub828\ub41c \uc800\uc791\uad8c \uae30\ud0c0 \ubaa8\ub4e0 \uad8c\ub9ac\ub294 \ucf54\ucf54\ud3ec\ub9ac\uc544 \uc8fc\uc2dd\ud68c\uc0ac \ub610\ub294 \uc815\ub2f9\ud55c \uad8c\ub9ac\ub97c \uac00\uc9c4 \uc81c3\uc790\uc5d0\uac8c \uadc0\uc18d\ub429\ub2c8\ub2e4.","\u300c\u30b3\u30b3\u30d5\u30a9\u30ea\u30a2\u300d\u306f\u30de\u30c3\u30d7\u3084\u99d2\u3092\u52d5\u304b\u3057\u306a\u304c\u3089\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30a2\u30d0\u30bf\u30fc\u3067\u3001":"CCFOLIA\ub294 \ub9f5\uc774\ub098 \ud1a0\ud070\uc744 \uc6c0\uc9c1\uc774\uba74\uc11c \uce90\ub9ad\ud130 \uc544\ubc14\ud0c0\ub85c","\u300c\u30b3\u30b3\u30d5\u30a9\u30ea\u30a2\u300d\u3092\u4f7f\u3046\u3060\u3051\u3067\u3082\u3042\u308b\u7a0b\u5ea6\u96f0\u56f2\u6c17\u304c\u51fa\u308b\u3088\u3046\u306a\u753b\u9762\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3002":"CCFOLIA\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\ub9cc\uc73c\ub85c\ub3c4 \uc5b4\ub290 \uc815\ub3c4 \ubd84\uc704\uae30\uac00 \ub098\uc624\ub294 \ud654\uba74\uc785\ub2c8\ub2e4.","\u300c\u30d7\u30e9\u30a4\u30d9\u30fc\u30c8\u300d\u306e\u30e1\u30f3\u30d0\u30fc\u306b\u306a\u308c\u308b\u306e\u306f\u30ed\u30b0\u30a4\u30f3\u30e6\u30fc\u30b6\u30fc\u306e\u307f\u3067\u3059\u3002":"\u300c\ud504\ub77c\uc774\ube57\u300d\uc758 \uba64\ubc84\uac00 \ub420 \uc218 \uc788\ub294 \uac83\uc740 \ub85c\uadf8\uc778 \uc720\uc800 \ubfd0\uc785\ub2c8\ub2e4.","\u300c\u30d7\u30e9\u30a4\u30d9\u30fc\u30c8\u300d\u8a2d\u5b9a\u306f\u53b3\u5bc6\u306b\u901a\u4fe1\u306e\u4fdd\u8b77\u3092\u63d0\u4f9b\u3059\u308b\u3082\u306e\u3067\u306f\u306a\u304f\u3001\u30c1\u30e3\u30c3\u30c8\u30bf\u30d6\u306e\u8868\u793a\u72b6\u614b\u3092\u5909\u66f4\u3059\u308b\u3082\u306e\u3067\u3059\u3002":"\u300c\ud504\ub77c\uc774\ube57\u300d\uc124\uc815\uc740 \uc5c4\uaca9\ud558\uac8c \ud1b5\uc2e0 \ubcf4\ud638\ub97c \uc81c\uacf5\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ucc44\ud305 \ud0ed\uc758 \ud45c\uc2dc \uc0c1\ud0dc\ub97c \ubcc0\uacbd\ud558\ub294 \uac83\uc785\ub2c8\ub2e4.","\u3042\u305d\u3093\u3067":"\ud50c\ub808\uc774","\u3042\u306a\u305f\u306e\u4eca\u65e5\u306e\u904b\u52e2\u3092\u30c0\u30a4\u30b9\u3067\u5360\u3044\u307e\u3059\u3002":"\ub2f9\uc2e0\uc758 \uc624\ub298 \uc6b4\uc138\ub97c \ub2e4\uc774\uc2a4\ub85c \uc810\uce69\ub2c8\ub2e4.","\u304a\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307e\u3059\uff01":"\ucd95\ud558\ud569\ub2c8\ub2e4!","\u304a\u554f\u3044\u5408\u308f\u305b":"\ubb38\uc758","\u304a\u554f\u3044\u5408\u308f\u305b\u306f\u3053\u3061\u3089":"","\u304a\u63a2\u3057\u306e\u5546\u54c1\u306f\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002":"\ucc3e\uc73c\uc2dc\ub294 \uc0c1\ud488\uc740 \ubc1c\uacac\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4.","\u304a\u8cb7\u3044\u4e0a\u3052\u3044\u305f\u3060\u304d\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002\u30eb\u30fc\u30e0\u306e\u4f5c\u6210\u3084\u30d5\u30a1\u30a4\u30eb\u306e\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3092\u3059\u308b\u306b\u306f\u3001\u30e9\u30a4\u30d6\u30e9\u30ea\u306b\u79fb\u52d5\u3057\u3066\u304f\u3060\u3055\u3044\u3002":"\uad6c\ub9e4\ud574\uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4. \ub8f8\uc744 \ub9cc\ub4e4\uac70\ub098 \ud30c\uc77c\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\ub824\uba74 \ub77c\uc774\ube0c\ub7ec\ub9ac\ub85c \uc774\ub3d9\ud558\uc2ed\uc2dc\uc624.","\u304c\u30ea\u30ea\u30fc\u30b9\u3055\u308c\u307e\u3057\u305f\uff01":"\uac00 \ucd9c\uc2dc\ub418\uc5c8\uc2b5\ub2c8\ub2e4!","\u3053\u3061\u3089\u306eURL\u306f\u3054\u5229\u7528\u3044\u305f\u3060\u3051\u307e\u305b\u3093\u3002\u4ee5\u4e0b\u306e\u7406\u7531\u3067URL\u304c\u7121\u52b9\u306b\u306a\u3063\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002":"\uc774 URL\uc740 \uc774\uc6a9\ud558\uc2e4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc544\ub798 \uc0ac\uc720\ub85c URL\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc744 \uac00\ub2a5\uc131\uc774 \uc788\uc2b5\ub2c8\ub2e4.","\u3053\u306eSNS\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u7d10\u3065\u3044\u3066\u3044\u308bCCFOLIA\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u304c\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u304a\u6301\u3061\u3067\u306a\u3044\u65b9\u306f\u300c\u65b0\u898f\u30a2\u30ab\u30a6\u30f3\u30c8\u4f5c\u6210\u300d\u3092\u3054\u5229\u7528\u304f\u3060\u3055\u3044\u3002":"\uc774 SNS \uacc4\uc815\uacfc \uc5f0\uacb0\ub41c CCFOLIA \uacc4\uc815\uc774 \uc874\uc7ac\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uacc4\uc815\uc774 \uc5c6\uc73c\uc2e0 \ubd84\uc740 \'\uc2e0\uaddc\uacc4\uc815 \ub9cc\ub4e4\uae30\'\ub97c \uc774\uc6a9\ud574 \uc8fc\uc2dc\uae30 \ubc14\ub78d\ub2c8\ub2e4.","\u3053\u306eURL\u304b\u3089\u30eb\u30fc\u30e0\u3092\u4f5c\u6210\u3059\u308b\u306b\u306f\u3001\u4e0a\u8a18\u306e\u30b2\u30fc\u30e0\u3092\u3054\u8cfc\u5165\u3044\u305f\u3060\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002":"\uc774 URL\ub85c \ub8f8\uc744 \ub9cc\ub4e4\uae30 \uc704\ud574\uc11c\ub294 \uc704 \uac8c\uc784\uc744 \uad6c\uc785\ud558\uc154\uc57c \ud569\ub2c8\ub2e4.","\u3053\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u306f\u65e2\u306b\u4ed6\u306e\u30e6\u30fc\u30b6\u30fc\u306b\u9023\u643a\u3055\u308c\u3066\u3044\u307e\u3059":"\uc774 \uacc4\uc815\uc740 \uc774\ubbf8 \ub2e4\ub978 \uc720\uc800\uac00 \uc0ac\uc6a9\uc911\uc785\ub2c8\ub2e4","\u3053\u306e\u30b2\u30fc\u30e0\u306e\u8ffd\u52a0\u30fb\u62e1\u5f35\u7528\u30b3\u30f3\u30c6\u30f3\u30c4":"\uc774 \uac8c\uc784\uc758 \ucd94\uac00 \ubc0f \ud655\uc7a5\uc6a9 \ucf58\ud150\uce20","\u3053\u306e\u30b9\u30ed\u30c3\u30c8\u306b\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u4fdd\u5b58\u3057\u307e\u3059\u304b\uff1f":"\uc774 \uc2ac\ub86f\uc5d0 \uc138\uc774\ube0c \ub370\uc774\ud130\ub97c \uc800\uc7a5\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?","\u3053\u306e\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u524a\u9664\u3057\u307e\u3059\u304b\uff1f":"\uc774 \uc138\uc774\ube0c \ub370\uc774\ud130\ub97c \uc0ad\uc81c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?","\u3053\u306e\u30bf\u30d6\u3092\u672c\u5f53\u306b\u524a\u9664\u3057\u307e\u3059\u304b\uff1f \u524a\u9664\u3059\u