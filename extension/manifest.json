{
  "manifest_version": 3,
  "name": "CC Replay Recorder",
  "version": "0.3.2",
  "minimum_chrome_version": "116",
  "description": "열린 코코포리아 방의 장면, 토큰, 채팅, BGM을 로컬 리플레이 파일에 기록합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "https://ccfolia.com/*",
    "https://*.ccfolia.com/*",
    "https://firebasestorage.googleapis.com/*",
    "https://storage.googleapis.com/*",
    "https://*.firebasestorage.app/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "https://storage.ccfolia-cdn.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CC Replay"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
